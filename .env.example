# Database (Railway provides this automatically)
DATABASE_URL=postgresql://fitness:fitness@localhost:5432/fitness_bot

# Redis (Railway provides this automatically)
REDIS_URL=redis://localhost:6379/0

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# The user's WhatsApp number (with country code)
USER_WHATSAPP_NUMBER=whatsapp:+972...

# OpenAI Whisper (for voice transcription)
OPENAI_API_KEY=sk-...

# Cloudflare R2 (for photo storage)
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=fitness-photos
R2_PUBLIC_URL=https://pub-....r2.dev

# Strava
STRAVA_CLIENT_ID=...
STRAVA_CLIENT_SECRET=...
STRAVA_VERIFY_TOKEN=fitness_bot_strava_verify

# Google Calendar
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Apple Health shortcut API key (generate any random UUID)
HEALTH_SHORTCUT_API_KEY=...

# Dashboard access key (generate any random UUID)
DASHBOARD_API_KEY=...

# App base URL (your Railway URL or ngrok URL for dev)
APP_BASE_URL=https://your-app.railway.app

# User info
USER_NAME=User
USER_TIMEZONE=Asia/Jerusalem
